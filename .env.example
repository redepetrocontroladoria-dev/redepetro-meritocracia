# PostgreSQL Neon (pooled — uso da aplicação)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"

# PostgreSQL Neon (direta — migrations / db push)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Segredo para assinar o cookie de sessão
AUTH_SECRET="troque-por-um-segredo-forte-em-producao"

# Injetadas pelo Neon CLI (neon deploy / neon env pull)
NEON_BRANCH=""
NEON_BRANCH_ID=""
NEON_FUNCTION_HOST_SUFFIX=""
